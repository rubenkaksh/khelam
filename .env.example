# Copy this file to `.env` and adjust values for your environment.
#
# Base URL of the rms-futsal-backend API (NestJS default port: 5000).
# - iOS simulator / macOS: http://localhost:5000
# - Android emulator:      http://10.0.2.2:5000
API_BASE_URL=http://localhost:5000

# The schedule feature falls back to MockBookingService when API_BASE_URL is
# not set (e.g. fresh clones, widget tests). Set to true to force the mock
# even when API_BASE_URL is present.
# USE_MOCK_BOOKING=false

# Google Sign-In client identifiers (replace with the real values from the
# Google Cloud console -> Credentials page).
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_SERVER_CLIENT_ID=replace-me.apps.googleusercontent.com
