<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.khelam.weekly-review</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/rubenk/projects/khel-service/khelam/scripts/weekly_review.sh</string>
  </array>
  <!-- Every Sunday 18:00 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>18</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/rubenk</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/weekly-review.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/weekly-review.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
