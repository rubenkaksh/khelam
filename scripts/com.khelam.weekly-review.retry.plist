  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/rubenk/.local/bin</string>
    <key>HOME</key>
    <string>/Users/rubenk</string>
