#!/bin/sh
# codegraph-refresh-hook-start
# CodeGraph auto-refresh (hook-only, forkable-first canonical template).
#
# Fires detached after every commit in repos with a .codegraph/ index.
# Runs `codegraph sync` (cheap, incremental, idempotent) in the background so
# git commit never stalls. Failures are logged to ~/.cache/codegraph-refresh-*.log
# and notified via report_sink.sh (rate-limited).
#
# Canonical: forkable/scripts/git-hooks/post-commit.codegraph
# Installed by: forkable/scripts/install_codegraph_hooks.sh (idempotent)
#
# Design note (2026-08-08): refresh is hook-only by user decision — no launchd
# timer. A weekly freshness_check() in weekly_review.sh catches a broken hook.
_cg_top="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -n "$_cg_top" ]; then
    _cg_script=""
    for _s in "$_cg_top/scripts/codegraph_refresh.sh" \
              "${FORKABLE_REPO:-$HOME/projects/forkable}/scripts/codegraph_refresh.sh"; do
        [ -x "$_s" ] && _cg_script="$_s" && break
    done
    if [ -n "$_cg_script" ]; then
        "$_cg_script" "$_cg_top" >>"${HOME}/.cache/codegraph-refresh-hook.log" 2>&1 &
    fi
fi
# codegraph-refresh-hook-end
