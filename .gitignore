# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
.aider*
/node_modules
/.understand-anything
# Local overrides (personal, never committed)
pubspec_overrides.yaml

# Android Google Services (contains OAuth client secrets)
android/app/google_services.json

# Environment secrets (real credentials — never commit; .env.example is the committed template)
.env

# Generated knowledge graph (auto-built by graphify hooks)
graphify-out/

# Generated docs
docs/*.pdf
*.code-workspace

# Local screenshot artifacts (regenerable, for PR review — never committed)
docs/screenshots/
